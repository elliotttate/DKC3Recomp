<<<<
    const long step_cap = interp_step_cap();
    long steps = 0;
====
    const long step_cap = interp_step_cap();
    long steps = 0;
    /* Live return frames this run owns: base S (the S after the call pushed
     * the frame), frame size, and the continuation. */
    enum { kArrivalFrames = 32 };
    uint16_t rec_sp[kArrivalFrames];
    uint8_t rec_fs[kArrivalFrames];
    uint32_t rec_ret[kArrivalFrames];
    int rec_count = 0;
    /* The run's own frame (a balanced run on its compiled caller's frame).
     * Only balanced runs set it, and they pass no out_return_pc. */
    const uint8_t bottom_hrv = out_return_pc ? 0 : s_run_hrv;
    s_run_hrv = 0;
    /* Nesting bound: each arrival bounce whose body tiers down before its
     * frame returns nests one more interpreter run; a guest loop at the frame
     * base could repeat that per iteration. Past the bound, interpret. */
    const int arrival_ok = arrival_bounce_enabled() && lle_yield_bounce_enabled() &&
                           !stop_on_rti && !n_stop && s_interp_bridge_depth < 12;
    if (s_arrival_bounce_pc == (entry_pc24 & 0xFFFFFFu))
        arrival_negative_add(entry_pc24 & 0xFFFFFFu);
>>>>

@@ arrival-bounce-step
<<<<
        const int _poll_mode = yield_pc && !auto_quiescent;
====
        /* Frames the interpreter has since returned past are gone. */
        while (rec_count > 0) {
            const uint16_t above = (uint16_t)(in.sp - rec_sp[rec_count - 1]);
            if (above != 0 && above < 0x8000u) rec_count--; else break;
        }
        /* Step 0 is the PC the run's creator chose to interpret. */
        if (arrival_ok && steps > 0) {
            uint8_t a_fs = 0;
            uint32_t a_ret = 0xFFFFFFFFu;
            int a_rec = 0;
            if (rec_count > 0 && in.sp == rec_sp[rec_count - 1]) {
                a_fs = rec_fs[rec_count - 1];
                a_ret = rec_ret[rec_count - 1];
                a_rec = 1;
            } else if (rec_count == 0 && bottom_hrv && in.sp == s_exit) {
                a_fs = bottom_hrv;
            }
            const uint32_t a_key = a_fs ? arrival_key(pc_before, &in) : 0;
            if (a_fs && s_arrival_skip[arrival_slot(a_key)] != a_key) {
                int a_go = 0;
                if (!arrival_negative_has(pc_before & 0xFFFFFFu) &&
                    !lle_bounce_target_excluded(pc_before)) {
                    sync_interp_to_cpu(&in, cpu);
                    a_go = cpu_dispatch_has_entry(cpu, pc_before);
                }
                if (!a_go) {
                    s_arrival_skip[arrival_slot(a_key)] = a_key;
                } else {
                    if (s_apu_pending_master >= bridge_bounce_flush_thresh())
                        bridge_apu_flush(cpu);
                    int _apu_drv = g_interp_apu_driving;
                    g_interp_apu_driving = 0;
                    int _saved_bounce_base = s_interp_bounce_recomp_base;
                    int _saved_bounce_owner = s_interp_bounce_owner_depth;
                    s_interp_bounce_recomp_base = g_recomp_stack_top;
                    s_interp_bounce_owner_depth = s_interp_bridge_depth;
                    cpu_take_tailcall_return_context(NULL, NULL);
                    const uint32_t _saved_arrival_pc = s_arrival_bounce_pc;
                    const int _saved_arrival_depth = s_arrival_bounce_depth;
                    s_arrival_bounce_pc = pc_before & 0xFFFFFFu;
                    s_arrival_bounce_depth = s_interp_bridge_depth;
                    const uint64_t _arrival_mc0 = cpu->master_cycles;
                    RecompReturn _air = cpu_dispatch_pc_paired(cpu, pc_before, a_fs);
                    s_arrival_bounce_depth = _saved_arrival_depth;
                    s_arrival_bounce_pc = _saved_arrival_pc;
                    if (s_lle_unwind_active)
                        arrival_note_unwind(pc_before & 0xFFFFFFu,
                                            cpu->master_cycles - _arrival_mc0);
                    s_interp_bounce_owner_depth = _saved_bounce_owner;
                    s_interp_bounce_recomp_base = _saved_bounce_base;
                    g_interp_apu_driving = _apu_drv;
                    sync_cpu_to_interp(cpu, &in);
                    if (_air == RECOMP_RETURN_NORMAL) {
                        if (a_rec) {
                            rec_count--;
                            in.k  = (uint8)((a_ret >> 16) & 0xFF);
                            in.pc = (uint16)(a_ret & 0xFFFF);
                            if (reset_cap_on_bounce) steps = 0;
                            continue;
                        }
                        /* The run's own frame was consumed: the routine
                         * returned to the compiled caller that owns it. */
                        sync_interp_to_cpu(&in, cpu);
                        bridge_apu_flush(cpu);
                        return 1;
                    }
                    if (s_lle_unwind_active) {
                        if (s_lle_unwind_owner_depth == s_interp_bridge_depth) {
                            s_lle_unwind_active = 0;
                            s_lle_unwind_owner_depth = 0;
                            sync_cpu_to_interp(cpu, &in);
                            if ((s_lle_unwind_pc24 & 0xFFFFFFu) == (pc_before & 0xFFFFFFu))
                                arrival_negative_add(pc_before & 0xFFFFFFu);
                            in.k  = (uint8)((s_lle_unwind_pc24 >> 16) & 0xFF);
                            in.pc = (uint16)(s_lle_unwind_pc24 & 0xFFFF);
                            continue;
                        }
                        sync_interp_to_cpu(&in, cpu);
                        return 1;
                    }
                    {
                        const uint16_t _owner_delta = (uint16_t)(in.sp - s_enter);
                        const int _skip_crossed_owner =
                            _owner_delta != 0 && _owner_delta < 0x8000u;
                        if (_air != RECOMP_RETURN_SKIP_1 || _skip_crossed_owner) {
                            sync_interp_to_cpu(&in, cpu);
                            if (!yield_pc && s_interp_bridge_depth > 1)
                                return (int)_air + 2;
                            return 1;
                        }
                    }
                    if (a_rec) {
                        rec_count--;
                        in.k  = (uint8)((a_ret >> 16) & 0xFF);
                        in.pc = (uint16)(a_ret & 0xFFFF);
                        continue;
                    }
                    sync_interp_to_cpu(&in, cpu);
                    bridge_apu_flush(cpu);
                    return 1;
                }
            }
        }
        const int _poll_mode = yield_pc && !auto_quiescent;
