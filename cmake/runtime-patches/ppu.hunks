  // A straight run: dst[x] = max(dst[x], src[x + shift]) for x in
  // [x_begin, x_stop). Only used when every source column is in range.
#define DKC3_MERGE_PADDED_RUN(x_begin, x_stop, shift) \
  do { \
    const int run_begin = (x_begin), run_stop = (x_stop), run_shift = (shift); \
    if (run_begin < run_stop) { \
      if (run_begin + run_shift < sx_min || \
          run_stop - 1 + run_shift > sx_max) { \
        DKC3_MERGE_PADDED_SLOW(run_begin, run_stop) \
      } else { \
        PpuZbufType *__restrict run_dst = dst + run_begin + kPpuExtraLeftRight; \
        const PpuZbufType *__restrict run_src = \
            src + run_begin + run_shift + kPpuExtraLeftRight; \
        for (int n = run_stop - run_begin; n > 0; n--, run_dst++, run_src++) { \
          const PpuZbufType s_ = *run_src, d_ = *run_dst; \
          *run_dst = s_ > d_ ? s_ : d_; \
        } \
      } \
    } \
  } while (0)
  // A margin continued from a period: the source column starts at the
  // original formula's value for the first pixel and then advances by one,
  // wrapping from base + period back to base, exactly as the modulo did.
#define DKC3_MERGE_PADDED_CYCLE(x_begin, x_stop, base, sx_start) \
  do { \
    const int cyc_begin = (x_begin), cyc_stop = (x_stop); \
    const int cyc_base = (base); \
    if (cyc_begin < cyc_stop) { \
      if (cyc_base < sx_min || cyc_base + repeat_period - 1 > sx_max) { \
        DKC3_MERGE_PADDED_SLOW(cyc_begin, cyc_stop) \
      } else { \
        int cyc_sx = (sx_start); \
        PpuZbufType *__restrict cyc_dst = dst + cyc_begin + kPpuExtraLeftRight; \
        const PpuZbufType *cyc_src_base = src + cyc_base + kPpuExtraLeftRight; \
        const PpuZbufType *__restrict cyc_src = src + cyc_sx + kPpuExtraLeftRight; \
        for (int n = cyc_stop - cyc_begin; n > 0; n--, cyc_dst++) { \
          const PpuZbufType s_ = *cyc_src, d_ = *cyc_dst; \
          *cyc_dst = s_ > d_ ? s_ : d_; \
