  } while (0)

  // Left margin: x in [x_first, copy_lo).
  {
    const int m_begin = x_first;
    const int m_stop = IntMin(copy_lo, x_end);
    if (m_begin < m_stop) {
      if (interior_period) {
        DKC3_MERGE_PADDED_CYCLE(
            m_begin, m_stop, interior_first,
            interior_first +
