# Tier-2 coverage journals are promotion telemetry for the recompiler's
# burn-down loop, not a player-facing feature; upstream snesrecomp 8d12911
# made them opt in. Every DKC3 run appended a JSONL journal beside the
# working directory and wrote a manifest at exit. Both now require
# SNESRECOMP_TIER2_CAPTURE=1 (or SNESRECOMP_TIER2=1).
file: runner/src/snes/tier2_capture.c

