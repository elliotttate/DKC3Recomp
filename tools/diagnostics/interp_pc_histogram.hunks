@@ diag-pc-histogram-dump
<<<<
static int itrace_enabled(void) {
====
uint32_t *g_dkc3_diag_pc_hist;
void dkc3_diag_dump_pc_hist(void) {
    const char *path = getenv("DKC3_DIAG_PC_HIST");
    if (!path || !g_dkc3_diag_pc_hist) return;
    FILE *f = fopen(path, "w");
    if (!f) return;
    for (uint32_t pc = 0; pc < (1u << 24); pc++)
        if (g_dkc3_diag_pc_hist[pc]) fprintf(f, "%06X %u\n", pc, g_dkc3_diag_pc_hist[pc]);
    fclose(f);
}
static int itrace_enabled(void) {
