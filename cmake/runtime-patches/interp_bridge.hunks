# Jump-arrival bounce. The bridge bounced only JSR/JSL arrivals into
# compiled bodies, because a body entered at a jump target has no return
# frame of its own to host-return through. The interpreter does know that
# frame whenever it is the one that pushed it: a call it could not bounce,
# or a bounce that unwound back inside the callee, leaves the callee's
# return frame at a known S with a known size and continuation. A nested
# balanced run likewise sits on its compiled caller's frame (its exit
# watermark plus that caller's hrv). While S equals such a frame base, any
# compiled entry the interpreter reaches by jump, fall-through, computed
# jump or unwind resume is a tail position of that frame and can run paired
# with the same size: the body's RTS/RTL host-returns through the very frame
# it would have popped, and the interpreter resumes at the recorded
# continuation (or reports its own frame's run complete). S must match
# exactly; anything pushed since makes the arrival ineligible.
# SNESRECOMP_LLE_JUMP_BOUNCE=0 disables it (A/B lever).
@@ arrival-bounce-statics
<<<<
static BridgeDynamicValue s_bridge_dynamic_values[64];
====
static BridgeDynamicValue s_bridge_dynamic_values[64];

/* Return-frame size a balanced tier run was entered with (its caller's hrv),
 * read once by the core at entry; 0 for runs without such a frame. */
static uint8_t s_run_hrv;

/* (pc24, m, x) keys that must not be bounced on arrival: no compiled variant,
 * excluded by policy, or the body unwound straight back to its own entry (an
 * interpreter-routed primitive). Direct-mapped; an eviction only costs a
 * re-probe. Keeps the per-step cost of the arrival check to a compare. */
static uint32_t s_arrival_skip[1024];
static uint32_t arrival_key(uint32_t pc24, const Interp816 *in) {
    return (pc24 & 0xFFFFFFu) | ((uint32_t)(in->mf ? 1 : 0) << 24) |
           ((uint32_t)(in->xf ? 1 : 0) << 25) | 0x80000000u;
}
static inline unsigned arrival_slot(uint32_t key) {
    return (key ^ (key >> 10) ^ (key >> 20)) & 1023u;
}
/* Entries whose bounce unwound back to the same PC; permanent, so a table
 * eviction cannot re-arm a bounce that is known to be a routed primitive. */
static uint32_t s_arrival_negative[64];
static unsigned s_arrival_negative_count;
static int arrival_negative_has(uint32_t pc24) {
    const unsigned n = s_arrival_negative_count < 64 ? s_arrival_negative_count : 64;
    for (unsigned i = 0; i < n; i++)
        if (s_arrival_negative[i] == pc24) return 1;
    return 0;
}
static void arrival_negative_add(uint32_t pc24) {
    if (arrival_negative_has(pc24)) return;
    s_arrival_negative[s_arrival_negative_count++ & 63] = pc24;
}
/* PC of the compiled entry an arrival bounce is running, for the nested run
 * that entry may start: a body whose first act is to tier down to the
 * interpreter at its own entry (a lone `JMP (abs)` through a WRAM pointer)
 * would otherwise be bounced again from inside that run, without bound. */
static uint32_t s_arrival_bounce_pc = 0xFFFFFFFFu;
/* Bridge depth of the interpreter that made the active bounce an arrival
 * bounce; 0 while the active bounce is a call bounce. */
static int s_arrival_bounce_depth;
/* A body that unwinds back to the interpreter within a few guest
 * instructions of its entry (a sprite main that far-jumps at once, a routed
 * primitive a few bytes in) costs a bounce and an unwind for nothing. Two
 * such unwinds in a row retire the entry; a run past the threshold clears
 * the strike, so a body that merely met the frame deadline once stays. */
static uint32_t s_arrival_strike_pc[256];
static uint8_t s_arrival_strike_n[256];
static void arrival_note_unwind(uint32_t pc24, uint64_t master_delta) {
    const unsigned slot = (pc24 ^ (pc24 >> 8) ^ (pc24 >> 16)) & 255u;
    if (master_delta >= 200) {
        if (s_arrival_strike_pc[slot] == pc24) s_arrival_strike_n[slot] = 0;
        return;
    }
    if (s_arrival_strike_pc[slot] != pc24) {
        s_arrival_strike_pc[slot] = pc24;
        s_arrival_strike_n[slot] = 0;
    }
    if (++s_arrival_strike_n[slot] >= 2) arrival_negative_add(pc24);
}
static int arrival_bounce_enabled(void) {
    static int v = -1;
    if (v < 0) {
        const char *e = getenv("SNESRECOMP_LLE_JUMP_BOUNCE");
        v = (e && e[0]) ? (e[0] != '0') : 1;
    }
    return v;
}
