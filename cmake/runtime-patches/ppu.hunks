# The padded merge walked every presented column through a per-pixel
# branch chain with two modulo operations. The same source column sequence
# is now produced with three straight passes: the authentic window (a
# contiguous max-merge, with the edge-repair columns as their own shifted
# runs) and each margin as a running index that wraps at the period or
# reflects. Any source range the original clamp could touch falls back to
# the original per-pixel formula, so the output is identical by
# construction. The straight passes read one buffer and write the other
# (the isolated layer render and the live priority buffer never alias), so
# their pointers are restrict-qualified and the merge is an unconditional
# max store, which lets the compiler vectorize it.
@@ merge-padded-fast
<<<<
  const bool interior_period = repeat && repeat_period < kPpuXPixels;
  for (int x = -left_extra; x < kPpuXPixels + right_extra; x++) {
    const int di = x + kPpuExtraLeftRight;
    int sx;
    if (x >= copy_lo && x < copy_hi) {
      sx = x;
      if (repeat && edge_repair != 0) {
        if (x >= a0 && x < a0 + edge_repair)
          sx += repeat_period;
        else if (x < a1 && x >= a1 - edge_repair)
          sx -= repeat_period;
      }
    } else if (x < copy_lo) {
      if (interior_period)
        sx = interior_first +
             ((x - interior_first) % repeat_period + repeat_period) %
                 repeat_period;
      else if (repeat)
        sx = a0 + ((x - a0) % repeat_period + repeat_period) % repeat_period;
      else
        sx = 2 * a0 - x;
    } else {
      if (interior_period)
        sx = (interior_last - repeat_period) +
             (x - (interior_last - repeat_period)) % repeat_period;
      else if (repeat)
        sx = a0 + (x - a0) % repeat_period;
      else
        sx = 2 * (a1 - 1) - x;
    }
    if (sx < -left_extra) sx = -left_extra;
    if (sx >= kPpuXPixels + right_extra) sx = kPpuXPixels + right_extra - 1;
    const int si = sx + kPpuExtraLeftRight;
    if (src[si] > dst[di]) dst[di] = src[si];
  }
}
