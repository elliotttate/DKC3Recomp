# The 4bpp renderer asked PpuViewportAllows about every opaque pixel. Its
# answer is an interval of screen columns per window span (the source-space
# inset shifts by that span's bias), so the interval is computed once per
# span and each pixel makes one range compare. The cheap opacity test now
# runs before the range compare; both are side-effect free.
#
# The per-pixel planar decode (four shifts, four masks, three ors and a
# separate opacity mask per pixel) is replaced by one table lookup per
# bitplane byte per tile row, producing the eight pixels as nibbles; each
# pixel is then a shift and a mask, and a nonzero nibble is the opacity
# test. The tables are built by the preprocessor from the same bit
# mappings the old macros used.
@@ viewport-4bpp-macros
<<<<
#define VIEWPORT_ALLOWED(i) \
  PpuViewportAllows(ppu, layer, \
      (int)(dstz + (i) - dstbuf->data - kPpuExtraLeftRight), \
      (int)(dstz + (i) - dstbuf->data - kPpuExtraLeftRight) + \
          ws_bias[windex])
#define DO_PIXEL(i) do { \
  pixel = (bits >> i) & 1 | (bits >> (7 + i)) & 2 | (bits >> (14 + i)) & 4 | (bits >> (21 + i)) & 8; \
  if (VIEWPORT_ALLOWED(i) && (bits & (0x01010101 << i)) && z > dstz[i]) dstz[i] = z + pixel; } while (0)
#define DO_PIXEL_HFLIP(i) do { \
  pixel = (bits >> (7 - i)) & 1 | (bits >> (14 - i)) & 2 | (bits >> (21 - i)) & 4 | (bits >> (28 - i)) & 8; \
  if (VIEWPORT_ALLOWED(i) && (bits & (0x80808080 >> i)) && z > dstz[i]) dstz[i] = z + pixel; } while (0)
====
#define VIEWPORT_ALLOWED(i) \
  (vp_all || \
   (unsigned)((int)(dstz + (i) - dstbuf->data - kPpuExtraLeftRight) - vp_lo) < \
       (unsigned)vp_len)
/* One tile row as eight 4-bit pixels in screen order, nibble i = screen
 * pixel i, built from the four bitplane bytes through the spread tables.
 * A tile with X flip (bit 14) reads source bit i for screen pixel i; an
 * unflipped tile reads source bit 7 - i. */
#define CHUNKY_FROM_BITS(bits, flipped) Dkc3Chunky4bpp((bits), (flipped) != 0)
#define DO_PIXEL(i) do { \
  pixel = (int)((chunky >> (4 * (i))) & 0xfu); \
  if (pixel && VIEWPORT_ALLOWED(i) && z > dstz[i]) dstz[i] = z + pixel; } while (0)
#define DO_PIXEL_HFLIP(i) DO_PIXEL(i)
