@@ chunky-4bpp-tables
<<<<
// Draw a whole line of a 4bpp background layer into bgBuffers
static void PpuDrawBackground_4bpp(Ppu *ppu, PpuPixelPrioBufs *dstbuf,
                                   uint y, bool sub, uint layer,
                                   PpuZbufType zhi, PpuZbufType zlo) {
====
/* Spread tables for the 4bpp tile decode: entry b places each bit of the
 * bitplane byte b in the low bit of one nibble. Norm maps source bit 7 - i
 * to nibble i (an unflipped tile); Flip maps source bit i to nibble i. */
#define DKC3_SPREAD_NORM(b) \
  ((uint32)(((b) >> 7) & 1) | (uint32)(((b) >> 6) & 1) << 4 | \
   (uint32)(((b) >> 5) & 1) << 8 | (uint32)(((b) >> 4) & 1) << 12 | \
   (uint32)(((b) >> 3) & 1) << 16 | (uint32)(((b) >> 2) & 1) << 20 | \
   (uint32)(((b) >> 1) & 1) << 24 | (uint32)((b) & 1) << 28)
#define DKC3_SPREAD_FLIP(b) \
  ((uint32)((b) & 1) | (uint32)(((b) >> 1) & 1) << 4 | \
   (uint32)(((b) >> 2) & 1) << 8 | (uint32)(((b) >> 3) & 1) << 12 | \
   (uint32)(((b) >> 4) & 1) << 16 | (uint32)(((b) >> 5) & 1) << 20 | \
   (uint32)(((b) >> 6) & 1) << 24 | (uint32)(((b) >> 7) & 1) << 28)
#define DKC3_SPREAD_8(F, b) \
  F(b), F((b) + 1), F((b) + 2), F((b) + 3), F((b) + 4), F((b) + 5), F((b) + 6), F((b) + 7)
#define DKC3_SPREAD_64(F, b) \
  DKC3_SPREAD_8(F, b), DKC3_SPREAD_8(F, (b) + 8), DKC3_SPREAD_8(F, (b) + 16), \
  DKC3_SPREAD_8(F, (b) + 24), DKC3_SPREAD_8(F, (b) + 32), DKC3_SPREAD_8(F, (b) + 40), \
  DKC3_SPREAD_8(F, (b) + 48), DKC3_SPREAD_8(F, (b) + 56)
#define DKC3_SPREAD_256(F) \
  DKC3_SPREAD_64(F, 0), DKC3_SPREAD_64(F, 64), DKC3_SPREAD_64(F, 128), DKC3_SPREAD_64(F, 192)
static const uint32 kDkc3Spread4bppNorm[256] = { DKC3_SPREAD_256(DKC3_SPREAD_NORM) };
static const uint32 kDkc3Spread4bppFlip[256] = { DKC3_SPREAD_256(DKC3_SPREAD_FLIP) };
/* One 4bpp tile row (planes 0-3 in the four bytes of `bits`) as eight
 * nibbles in screen order; see DKC3_SPREAD_NORM/FLIP. */
static inline uint32 Dkc3Chunky4bpp(uint32 bits, int flipped) {
  const uint32 *t = flipped ? kDkc3Spread4bppFlip : kDkc3Spread4bppNorm;
  return t[bits & 0xffu] | t[(bits >> 8) & 0xffu] << 1 |
         t[(bits >> 16) & 0xffu] << 2 | t[bits >> 24] << 3;
}
#undef DKC3_SPREAD_256
#undef DKC3_SPREAD_64
#undef DKC3_SPREAD_8
#undef DKC3_SPREAD_FLIP
#undef DKC3_SPREAD_NORM

