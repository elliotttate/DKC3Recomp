# The cooperative-poll recognizers read the opcode and branch bytes ahead of
# every interpreted instruction, but only consult them for a yield-PC run
# that is not auto-quiescent. Neither DKC3 entry point is such a run (the
# frame scheduler is auto-quiescent; tier dispatch has no yield PC), so the
# two extra bus walks per instruction were pure overhead. The reads happen
# exactly as before when a recognizer can use them. They are untimed
# (bus timing is armed only around the executed opcode) and never touch a
# device window, so skipping them leaves guest state and timing unchanged.
@@ poll-prefetch-gate
<<<<
        const uint8_t _poll_op = bridge_bus_read(cpu, pc_before);
        const uint8_t _poll_branch = bridge_bus_read(cpu, pc_before + 3);
====
        const int _poll_mode = yield_pc && !auto_quiescent;
        const uint8_t _poll_op =
            _poll_mode ? bridge_bus_read(cpu, pc_before) : 0;
        const uint8_t _poll_branch =
            _poll_mode ? bridge_bus_read(cpu, pc_before + 3) : 0;
>>>>

