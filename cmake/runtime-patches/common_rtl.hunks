  if (hdr[1] >= 5 && g_rtl_game_info && g_rtl_game_info->state_load_extra &&
      memory.position < size && !memory.error)
    g_rtl_game_info->state_load_extra(&memory.base, hdr[1]);
  RtlApuUnlock();
