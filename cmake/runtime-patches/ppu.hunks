#define DKC3_MERGE_PADDED_MIRROR(x_begin, x_stop, axis) \
  do { \
    const int mir_begin = (x_begin), mir_stop = (x_stop), mir_axis = (axis); \
    if (mir_begin < mir_stop) { \
      if (mir_axis - (mir_stop - 1) < sx_min || mir_axis - mir_begin > sx_max) { \
        DKC3_MERGE_PADDED_SLOW(mir_begin, mir_stop) \
      } else { \
        PpuZbufType *__restrict mir_dst = dst + mir_begin + kPpuExtraLeftRight; \
        const PpuZbufType *__restrict mir_src = \
            src + mir_axis - mir_begin + kPpuExtraLeftRight; \
        for (int n = mir_stop - mir_begin; n > 0; n--, mir_dst++, mir_src--) { \
          const PpuZbufType s_ = *mir_src, d_ = *mir_dst; \
          *mir_dst = s_ > d_ ? s_ : d_; \
        } \
      } \
