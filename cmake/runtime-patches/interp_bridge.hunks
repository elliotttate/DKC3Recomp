# A body entered by a jump arrival that re-interprets from one of its own
# unresolved jumps (or a jump of a pure tail chain from it) would start a
# nested balanced run there. The jump is a terminal transfer, so that run
# interprets the whole guest continuation until the frame returns: for a
# sprite main's `JML [$04F5]` that is the rest of the frame's main loop,
# inside a run that cannot yield at WAI or the frame deadline (the attract
# phase spun 2,000,000 steps to the cap, then abandoned). Before the arrival
# bounce that body ran in the owning interpreter, so hand the jump back to
# it, as tail dispatches do; the interpreter resumes exactly where it used to
# be. Call bounces keep nesting, which is their established behavior, and so
# do jumps in compiled callees of the arrival-bounced body.
@@ balanced-goto-unwind-to-owner
<<<<
RecompReturn interp_tier_dispatch_balanced(CpuState *cpu, uint32_t target_pc24,
                                           uint32_t site_pc24, uint16_t entry_s,
                                           uint8_t hrv) {
    interp_tier_note(target_pc24);
====
RecompReturn interp_tier_dispatch_balanced(CpuState *cpu, uint32_t target_pc24,
                                           uint32_t site_pc24, uint16_t entry_s,
                                           uint8_t hrv) {
    if ((target_pc24 & 0xFFFFFFu) == (site_pc24 & 0xFFFFFFu) &&
        s_interp_bounce_owner_depth > 0 &&
        s_arrival_bounce_depth == s_interp_bounce_owner_depth &&
        interp_bridge_has_direct_paired_bounce() &&
        !cpu_interrupt_context_active()) {
        (void)entry_s; (void)hrv;
        return interp_bridge_lle_yield_unwind(cpu, site_pc24 & 0xFFFFFFu);
    }
    interp_tier_note(target_pc24);
>>>>
