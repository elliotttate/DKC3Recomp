# An auto-quiescent run compares every interpreted instruction's state
# against all 64 entries of the quiescent ring: each visit loads a
# 56-byte entry to test its step and program counter before anything
# else. A parallel array of the entries' program counters lets the scan
# reject the 63 non-matching slots from four cache lines; a slot whose
# counter matches is checked with the original full condition, in the
# original order, so the first match and the repeat count are unchanged.
@@ quiescent-ring-pc-index
<<<<
    QuiescentState qring[64];
    if (auto_quiescent)
        memset(qring, 0, sizeof qring);
====
    QuiescentState qring[64];
    uint32_t qring_pc[64];
    if (auto_quiescent) {
        memset(qring, 0, sizeof qring);
        memset(qring_pc, 0xff, sizeof qring_pc);
    }
